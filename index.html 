<script>
function downloadCardImage(){
  const card = document.querySelector('.panel');

  if(typeof html2canvas === 'undefined'){
    alert('لم يتم تحميل أداة حفظ الصورة بعد، حاول مرة أخرى.');
    return;
  }

  html2canvas(card, {
    scale:2,
    useCORS:true,
    backgroundColor:'#ffffff'
  }).then(function(canvas){
    const link = document.createElement('a');
    link.download = 'بيانات_المركبة_3806.png';
    link.href = canvas.toDataURL('image/png');
    link.click();
  });
}

function downloadWalletFile(){
  const html = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
  const blob = new Blob([html], {
    type:'text/html;charset=utf-8'
  });

  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = 'استمارة_مركبة_3806.html';
  link.click();

  setTimeout(function(){
    URL.revokeObjectURL(link.href);
  },1000);
}

function exportJSONData(){
  const data = {
    المفوض_له: 'ديوان وزارة العدل ( تشغيل قضائي لنيابات والمحاكم )',
    رقم_الهوية: '7001661086',
    المسمى_الوظيفي: 'أخصائي قانوني أول | العمليات القانونية والتمثيل النظامي',
    اسم_المستفيد_أو_السائق: 'خالد بن فهد LEGAL AFFAIRS',
    نوع_المركبة: 'شيفرولية تاهو',
    الموديل: '2023',
    اللون: 'أسود',
    رقم_اللوحة: 'ر ر ط 5661',
    تاريخ_الانتهاء: '16/07/2029',
    حالة_العرض: 'تم التحقق بنجاح'
  };

  const blob = new Blob(
    [JSON.stringify(data, null, 2)],
    {type:'application/json;charset=utf-8'}
  );

  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = 'بيانات_المركبة_3806.json';
  link.click();

  setTimeout(function(){
    URL.revokeObjectURL(link.href);
  },1000);
}

function flipCard(){
  const card = document.querySelector('.card-inner');

  if(card){
    card.classList.toggle('flipped');
  }
}
</script>
