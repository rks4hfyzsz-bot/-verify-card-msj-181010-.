<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>الصفحة الرئيسية</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #f3f4f6;
      font-family: Arial, sans-serif;
    }

    .container {
      width: 90%;
      max-width: 500px;
      padding: 35px;
      text-align: center;
      background: #ffffff;
      border-radius: 16px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
    }

    h1 {
      margin-bottom: 25px;
      color: #1f2937;
    }

    .salary-button {
      display: inline-block;
      padding: 13px 28px;
      background: #1d4ed8;
      color: #ffffff;
      text-decoration: none;
      border-radius: 8px;
      font-size: 17px;
      font-weight: bold;
    }

    .salary-button:hover {
      background: #1e40af;
    }
  </style>
</head>

<body>
  <main class="container">
    <h1>الصفحة الرئيسية</h1>

    <a href="salary.html" class="salary-button">
      صفحة الراتب
    </a>
  </main>
</body>
</html>
