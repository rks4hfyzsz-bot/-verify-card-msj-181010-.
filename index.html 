         class="fixed bottom-5 right-5 bg-emerald-600 text-white px-4 py-3 rounded-xl shadow-2xl flex items-center gap-3 text-xs font-bold transition-all duration-300 translate-y-20 opacity-0 z-50">

        <i class="fa-solid fa-circle-check text-base"></i>
        <span id="toastMsg">تم التنفيذ بنجاح</span>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            try {
                if (typeof JsBarcode !== 'undefined') {
                    JsBarcode('#barcode', '56617001661086', {
                        format: 'CODE128',
                        lineColor: '#1e293b',
                        width: 2,
                        height: 45,
                        displayValue: false
                    });
                }
            } catch (error) {
                console.log('Barcode error:', error);
            }

            calculateExpiry();
        });

        function flipCard() {
            const card = document.getElementById('cardInner');

            if (card) {
                card.classList.toggle('flipped');
            }
        }

        function calculateExpiry() {
            const expiryDate = new Date('2029-07-16T23:59:59');
            const today = new Date();
            const difference = expiryDate - today;
            const days = Math.ceil(difference / (1000 * 60 * 60 * 24));
            const daysElement = document.getElementById('daysLeft');

            if (daysElement) {
                daysElement.innerText = days > 0 ? days : '0';
            }
        }

        function copyToClipboard(text, title) {
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text)
                    .then(function () {
                        showToast('تم نسخ ' + title + ': ' + text);
                    })
                    .catch(function () {
                        fallbackCopy(text, title);
                    });
            } else {
                fallbackCopy(text, title);
            }
        }

        function fallbackCopy(text, title) {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';

            document.body.appendChild(textarea);
            textarea.focus();
            textarea.select();

            try {
                document.execCommand('copy');
                showToast('تم نسخ ' + title + ': ' + text);
            } catch (error) {
                showToast('تعذر النسخ تلقائيًا');
            }

            document.body.removeChild(textarea);
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toastMsg');

            if (!toast || !toastMessage) {
                return;
            }

            toastMessage.innerText = message;

            toast.classList.remove('translate-y-20', 'opacity-0');

            setTimeout(function () {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3500);
        }

        function downloadCardImage() {
            const card = document.querySelector('.card-front');

            if (!card) {
                showToast('لم يتم العثور على البطاقة');
                return;
            }

            if (typeof html2canvas === 'undefined') {
                showToast('لم يتم تحميل أداة الصورة، حاول مرة أخرى');
                return;
            }

            showToast('جاري تجهيز صورة البطاقة');

            html2canvas(card, {
                scale: 3,
                useCORS: true,
                backgroundColor: null
            })
            .then(function (canvas) {
                const link = document.createElement('a');

                link.download = 'استمارة_مركبة_ر_ر_ط_5661.png';
                link.href = canvas.toDataURL('image/png');

                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                showToast('تم حفظ صورة البطاقة بنجاح');
            })
            .catch(function () {
                showToast('تعذر حفظ الصورة');
            });
        }

        function downloadWalletFile() {
            const htmlContent =
                '<!DOCTYPE html>\n' +
                document.documentElement.outerHTML;

            const blob = new Blob(
                [htmlContent],
                { type: 'text/html;charset=utf-8' }
            );

            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');

            link.href = url;
            link.download = 'استمارة_مركبة_ر_ر_ط_5661.html';

            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            setTimeout(function () {
                URL.revokeObjectURL(url);
            }, 1000);

            showToast('تم تحميل ملف HTML');
        }

        function exportJSONData() {
            const data = {
                title: 'استمارة مركبة - المملكة العربية السعودية',
                authorizedEntity: 'ديوان وزارة العدل',
                department: 'تشغيل قضائي لنيابات والمحاكم',
                identityNumber: '7001661086',
                jobTitle: 'أخصائي قانوني أول | العمليات القانونية والتمثيل النظامي',
                beneficiary: 'خالد بن فهد LEGAL AFFAIRS',
                vehicle: 'شيفرولية تاهو',
                model: '2023',
                color: 'أسود',
                plateNumber: 'ر ر ط 5661',
                expiryDate: '16/07/2029',
                status: 'تم التحقق بنجاح'
            };

            const json = JSON.stringify(data, null, 2);

            const blob = new Blob(
                [json],
                { type: 'application/json;charset=utf-8' }
            );

            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');

            link.href = url;
            link.download = 'بيانات_المركبة_ر_ر_ط_5661.json';

            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            setTimeout(function () {
                URL.revokeObjectURL(url);
            }, 1000);

            showToast('تم تحميل ملف البيانات JSON');
        }

        function sharePass() {
            const shareText =
                'استمارة مركبة\n' +
                'المفوض له: ديوان وزارة العدل\n' +
                'المركبة: شيفرولية تاهو 2023\n' +
                'رقم اللوحة: ر ر ط 5661\n' +
                'تاريخ الانتهاء: 16/07/2029';

            if (navigator.share) {
                navigator.share({
                    title: 'استمارة مركبة',
                    text: shareText,
                    url: window.location.href
                }).catch(function () {});
            } else {
                copyToClipboard(window.location.href, 'رابط الاستمارة');
            }
        }
    </script>
</body>
</html>
