        }

        @media print {
            body {
                background: white !important;
                color: black !important;
            }

            .no-print {
                display: none !important;
            }

            .card-inner {
                transform: none !important;
            }
        }

        @media (max-width: 640px) {
            .action-buttons {
                padding: 0 10px;
            }

            .action-buttons button {
                flex: 1 1 45%;
            }
        }
    </style>
